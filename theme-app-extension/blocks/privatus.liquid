{%- comment -%}
  Privatus Analytics app embed: prints the cookieless tracker in <head>.
  Enable it in Online Store → Themes → Customize → App embeds.
  Checkout and purchases are tracked by the Customer Events custom pixel (see README).
{%- endcomment -%}
{%- liquid
  assign site_id = block.settings.site_id | strip
  assign host = block.settings.script_host | strip | default: 'https://privatusanalytics.com'
  unless host contains '://'
    assign host = 'https://' | append: host
  endunless
  assign last_char = host | slice: -1
  if last_char == '/'
    assign host_size = host | size | minus: 1
    assign host = host | slice: 0, host_size
  endif

  assign modules = ''
  if block.settings.module_engage
    assign modules = modules | append: 'engage,'
  endif
  if block.settings.module_auto
    assign modules = modules | append: 'auto,'
  endif
  if block.settings.module_vitals
    assign modules = modules | append: 'vitals,'
  endif
  if block.settings.module_clicks
    assign modules = modules | append: 'clicks,'
  endif
  assign modules_size = modules | size
  if modules_size > 0
    assign modules_size = modules_size | minus: 1
    assign modules = modules | slice: 0, modules_size
  endif

  assign masks = '/account/orders/*->/account/orders/:id'
  if block.settings.mask != blank
    assign masks = block.settings.mask | strip | append: ',' | append: masks
  endif
-%}
{%- if site_id != blank and request.design_mode == false -%}
  <script>
    window.privatus=window.privatus||{q:[]};['track','pageview','props','optOut','optIn'].forEach(function(m){window.privatus[m]=window.privatus[m]||function(){window.privatus.q.push([m,Array.prototype.slice.call(arguments)])}});
  </script>
  <script
    defer
    src="{{ host | escape }}/js/pa.js"
    data-site="{{ site_id | escape }}"
    {%- if block.settings.spa != 'auto' %} data-spa="{{ block.settings.spa | escape }}"{% endif %}
    {%- if modules != 'engage' %} data-modules="{{ modules | escape }}"{% endif %}
    {%- if block.settings.domains != blank %} data-domains="{{ block.settings.domains | strip | escape }}"{% endif %}
    {%- if block.settings.exclude != blank %} data-exclude="{{ block.settings.exclude | strip | escape }}"{% endif %}
    data-mask="{{ masks | escape }}"
    {%- if block.settings.canonical %} data-canonical="true"{% endif %}
  ></script>
{%- endif -%}

{% schema %}
{
  "name": "Privatus Analytics",
  "target": "head",
  "settings": [
    {
      "type": "text",
      "id": "site_id",
      "label": "Site ID",
      "placeholder": "pa_XXXX",
      "info": "Your public site id from Privatus Analytics → Site settings → Setup."
    },
    {
      "type": "select",
      "id": "spa",
      "label": "SPA mode",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "history", "label": "History API" },
        { "value": "hash", "label": "Hash" },
        { "value": "off", "label": "Off" }
      ]
    },
    { "type": "header", "content": "Modules" },
    { "type": "checkbox", "id": "module_engage", "label": "Engagement (time on page, scroll depth)", "default": true },
    { "type": "checkbox", "id": "module_auto", "label": "Auto events (outbound links, downloads, forms)", "default": false },
    { "type": "checkbox", "id": "module_vitals", "label": "Core Web Vitals", "default": false },
    { "type": "checkbox", "id": "module_clicks", "label": "Click maps", "default": false },
    { "type": "header", "content": "Advanced" },
    {
      "type": "text",
      "id": "script_host",
      "label": "Script host",
      "placeholder": "https://privatusanalytics.com",
      "info": "Origin serving /js/pa.js and receiving hits. Keep the default unless you run a self-hosted instance."
    },
    { "type": "text", "id": "domains", "label": "Allowed domains", "placeholder": "shop.com,www.shop.com" },
    { "type": "text", "id": "exclude", "label": "Excluded paths", "placeholder": "/pages/internal*" },
    { "type": "text", "id": "mask", "label": "Path masks", "placeholder": "/u/*->/u/:id", "info": "Order status pages are always masked." },
    { "type": "checkbox", "id": "canonical", "label": "Use canonical URLs", "default": false }
  ]
}
{% endschema %}
